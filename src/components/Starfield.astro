---
// Deterministic page-wide starfield.
//
// Stars are placed via a seeded jittered grid: the viewport is divided into
// a cols x rows grid, each cell randomly kept or skipped, and kept cells
// place one star at a random offset within the cell. This gives a dispersed,
// non-clumpy look that's stable across reloads and viewport sizes.

type StarKind = 'cross' | 'dot';
type StarHue = 'white' | 'purple' | 'pink';

interface Star {
  x: number; // percent
  y: number; // percent
  scale: number;
  delay: number;
  duration: number;
  kind: StarKind;
  hue: StarHue;
}

const SEED = 0xc0ffee;
const COLS = 6;
const ROWS = 5;
const KEEP_PROBABILITY = 0.75;
const CELL_PADDING = 0.22; // inset inside each cell, 0..0.5
const CROSS_PROBABILITY = 0.7;
// Rectangular no-star zones in viewport percent (x from left, y from top).
// Any star whose center falls inside one of these boxes is omitted, so we
// can carve out space behind the intro text (and anywhere else later).
const EXCLUSION_ZONES: { x0: number; x1: number; y0: number; y1: number }[] = [
  { x0: 0, x1: 55, y0: 0, y1: 60 },
];
// Grid cells to force-skip regardless of the probability roll.
// Coords are "col,row" (0-indexed).
const SKIP_CELLS = new Set<string>(['5,0']);
// Per-cell post-adjust offsets in percent of viewport (vw for x, vh for y).
const CELL_OFFSETS: Record<string, { dx?: number; dy?: number }> = {
  '0,3': { dy: 3 },
  '0,4': { dy: 3 },
};

const inExclusionZone = (x: number, y: number) =>
  EXCLUSION_ZONES.some(
    (z) => x >= z.x0 && x <= z.x1 && y >= z.y0 && y <= z.y1,
  );

const mulberry32 = (a: number) => () => {
  a |= 0;
  a = (a + 0x6d2b79f5) | 0;
  let t = Math.imul(a ^ (a >>> 15), 1 | a);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

const rand = mulberry32(SEED);

const stars: Star[] = [];
const cellW = 100 / COLS;
const cellH = 100 / ROWS;

for (let row = 0; row < ROWS; row++) {
  for (let col = 0; col < COLS; col++) {
    const keepRoll = rand();
    const jitterX = CELL_PADDING + rand() * (1 - 2 * CELL_PADDING);
    const jitterY = CELL_PADDING + rand() * (1 - 2 * CELL_PADDING);
    const offset = CELL_OFFSETS[`${col},${row}`];
    const x = (col + jitterX) * cellW + (offset?.dx ?? 0);
    const y = (row + jitterY) * cellH + (offset?.dy ?? 0);

    if (SKIP_CELLS.has(`${col},${row}`)) continue;
    if (keepRoll > KEEP_PROBABILITY) continue;
    if (inExclusionZone(x, y)) continue;

    const kind: StarKind = rand() < CROSS_PROBABILITY ? 'cross' : 'dot';
    const hueRoll = rand();
    const hue: StarHue =
      kind === 'dot' && hueRoll < 0.5
        ? hueRoll < 0.25
          ? 'purple'
          : 'pink'
        : 'white';

    stars.push({
      x,
      y,
      scale: kind === 'cross' ? 0.75 + rand() * 0.7 : 0.6 + rand() * 0.6,
      delay: rand() * 2,
      duration: 1.1 + rand() * 1.2,
      kind,
      hue,
    });
  }
}
---

<div class="starfield" aria-hidden="true">
  {
    stars.map((s) => (
      <div
        class:list={['star', s.kind, `hue-${s.hue}`]}
        style={`left:${s.x.toFixed(3)}%;top:${s.y.toFixed(3)}%;--star-scale:${s.scale.toFixed(3)};--star-delay:${s.delay.toFixed(3)}s;--star-duration:${s.duration.toFixed(3)}s;`}
      >
        {s.kind === 'cross' && (
          <>
            <span class="star-h" />
            <span class="star-v" />
            <span class="star-c" />
          </>
        )}
      </div>
    ))
  }
</div>
