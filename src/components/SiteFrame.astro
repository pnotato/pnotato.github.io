<div class="site-frame" aria-hidden="true"></div>

<style>
  .site-frame {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    border: var(--frame-width) solid var(--color-frame);
    border-bottom-width: 0;
    pointer-events: none;
    transition: border-bottom-width 0.15s ease;
  }

  .site-frame.is-at-end {
    border-bottom-width: var(--frame-width);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-frame {
      transition: none;
    }
  }
</style>

<script>
  const frame = document.querySelector(".site-frame");

  if (frame) {
    const update = () => {
      const atEnd =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 2;
      frame.classList.toggle("is-at-end", atEnd);
    };

    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  }
</script>
