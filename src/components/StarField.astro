---
---

<div class="starfield" aria-hidden="true"></div>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .starfield :global(.star) {
    position: absolute;
    display: block;
    transform: translate(-50%, -50%);
    opacity: var(--min, 0.2);
    will-change: opacity;
  }

  .starfield :global(.star--dot) {
    background: currentColor;
    border-radius: 9999px;
  }

  .starfield :global(.star--spark) {
    line-height: 0;
  }

  .starfield :global(.star.is-sparking) {
    animation: star-burst 0.5s ease-out;
  }

  @keyframes star-burst {
    0% {
      opacity: var(--min, 0.2);
      transform: translate(-50%, -50%) scale(1);
      filter: brightness(1);
    }
    25% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.45);
      filter: brightness(2.4);
    }
    100% {
      opacity: var(--min, 0.2);
      transform: translate(-50%, -50%) scale(1);
      filter: brightness(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .starfield :global(.star.is-sparking) {
      animation: none;
      opacity: var(--max, 0.5);
    }
  }
</style>

<script>
  const COLORS = ["#ffffff", "#ffffff", "#ffffff", "#F2D8A7", "#8FA8D9"];
  const CELL = 150;
  const SEED = 20260924;
  const SPARK_PATH =
    "M8 0.6 Q10.2 5.8 15.4 8 Q10.2 10.2 8 15.4 Q5.8 10.2 0.6 8 Q5.8 5.8 8 0.6 Z";

  function mulberry32(seed: number) {
    return function () {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  interface Star {
    el: HTMLElement;
    x: number;
    y: number;
    r: number;
    inRange: boolean;
    timeout?: number;
  }

  const BURST_MS = 500;

  const field = document.querySelector<HTMLElement>(".starfield");
  const stars: Star[] = [];
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function trigger(s: Star) {
    if (reduce) return;
    s.el.classList.remove("is-sparking");
    void s.el.offsetWidth;
    s.el.classList.add("is-sparking");
    window.clearTimeout(s.timeout);
    s.timeout = window.setTimeout(() => {
      s.el.classList.remove("is-sparking");
    }, BURST_MS);
  }

  function near(s: Star, x: number, y: number) {
    const dx = (s.x / 100) * window.innerWidth - x;
    const dy = (s.y / 100) * window.innerHeight - y;
    return dx * dx + dy * dy <= s.r * s.r;
  }

  function render() {
    if (!field) return;

    const w = window.innerWidth;
    const h = window.innerHeight;
    const cols = Math.ceil(w / CELL);
    const rows = Math.ceil(h / CELL);
    const rand = mulberry32(SEED);

    let html = "";
    for (let row = 0; row < rows; row++) {
      for (let col = 0; col < cols; col++) {
        const x = ((col + 0.5 + (rand() - 0.5) * 0.85) / cols) * 100;
        const y = ((row + 0.5 + (rand() - 0.5) * 0.85) / rows) * 100;
        const color = COLORS[Math.floor(rand() * COLORS.length)];
        const sparkle = rand() < 0.4;
        const size = sparkle ? 3 + rand() * 9 : 1 + rand() * 1.6;
        const min = 0.12 + rand() * 0.16;
        const max = min + 0.22 + rand() * 0.28;

        const base =
          `left:${x.toFixed(3)}%;top:${y.toFixed(3)}%;color:${color};` +
          `--min:${min.toFixed(2)};--max:${max.toFixed(2)};`;

        if (sparkle) {
          html +=
            `<span class="star star--spark" data-x="${x.toFixed(3)}" data-y="${y.toFixed(3)}" data-r="${(size / 2 + 6).toFixed(2)}" style="${base}">` +
            `<svg viewBox="0 0 16 16" width="${size.toFixed(2)}" height="${size.toFixed(2)}">` +
            `<path d="${SPARK_PATH}" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/></svg></span>`;
        } else {
          html +=
            `<span class="star star--dot" data-x="${x.toFixed(3)}" data-y="${y.toFixed(3)}" data-r="${(size / 2 + 6).toFixed(2)}" style="${base}width:${size.toFixed(2)}px;height:${size.toFixed(2)}px;"></span>`;
        }
      }
    }

    field.innerHTML = html;

    stars.length = 0;
    field.querySelectorAll<HTMLElement>(".star").forEach((el) => {
      stars.push({
        el,
        x: parseFloat(el.dataset.x ?? "0"),
        y: parseFloat(el.dataset.y ?? "0"),
        r: parseFloat(el.dataset.r ?? "10"),
        inRange: false,
      });
    });
  }

  let mx = -1;
  let my = -1;
  let queued = false;

  function check() {
    queued = false;

    for (const s of stars) {
      const inRange = near(s, mx, my);

      if (inRange && !s.inRange) {
        trigger(s);
      }

      s.inRange = inRange;
    }
  }

  function schedule() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(check);
  }

  window.addEventListener("pointermove", (event) => {
    mx = event.clientX;
    my = event.clientY;
    schedule();
  });

  window.addEventListener("pointerdown", (event) => {
    for (const s of stars) {
      if (near(s, event.clientX, event.clientY)) {
        trigger(s);
      }
    }
  });

  let resizeFrame = 0;
  window.addEventListener("resize", () => {
    cancelAnimationFrame(resizeFrame);
    resizeFrame = requestAnimationFrame(render);
  });

  render();
</script>
