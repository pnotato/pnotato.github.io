---
/* Pure markup. The random scattered stars previously injected here are now
   part of the global Starfield that spans the whole page. */
---
<div class="space-container">
  <div class="rocket">
    <div class="rocket-body">
      <div class="rocket-flame">
        <div class="flame-part"></div>
      </div>
      <div class="rocket-main">
        <div class="rocket-nose"></div>
        <div class="rocket-window">
          <div class="rocket-window-highlight"></div>
        </div>
        <div class="rocket-stripe"></div>
        <div class="rocket-booster"></div>
        <div class="rocket-thruster"></div>
      </div>
      <div class="rocket-wing left"></div>
      <div class="rocket-wing right"></div>
    </div>
  </div>
</div>
