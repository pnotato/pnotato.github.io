    }
    15.33% {
      transform: translate(27.34cqw, 83.11cqh) rotate(5.0deg);
    }
    16.61% {
      transform: translate(31.14cqw, 84.18cqh) rotate(13.2deg);
    }
    17.89% {
      transform: translate(34.93cqw, 85.73cqh) rotate(13.9deg);
    }
    19.17% {
      transform: translate(38.81cqw, 86.96cqh) rotate(6.5deg);
    }
    20.44% {
      transform: translate(42.79cqw, 86.83cqh) rotate(-8.5deg);
    }
    21.72% {
      transform: translate(46.73cqw, 85.39cqh) rotate(-16.4deg);
    }
    23.00% {
      transform: translate(50.58cqw, 83.12cqh) rotate(-23.5deg);
    }
    24.28% {
      transform: translate(54.25cqw, 80.05cqh) rotate(-30.9deg);
    }
    25.56% {
      transform: translate(57.65cqw, 76.11cqh) rotate(-41.8deg);
    }
    26.83% {
      transform: translate(60.40cqw, 70.90cqh) rotate(-55.2deg);
    }
    28.11% {
      transform: translate(62.67cqw, 65.01cqh) rotate(-59.0deg);
    }
    29.39% {
      transform: translate(64.98cqw, 59.08cqh) rotate(-54.8deg);
    }
    30.67% {
      transform: translate(67.78cqw, 53.64cqh) rotate(-47.0deg);
    }
    31.94% {
      transform: translate(70.81cqw, 48.41cqh) rotate(-45.9deg);
    }
    33.22% {
      transform: translate(73.99cqw, 43.34cqh) rotate(-42.5deg);
    }
    34.50% {
      transform: translate(77.44cqw, 38.64cqh) rotate(-37.0deg);
    }
    35.78% {
      transform: translate(81.23cqw, 34.55cqh) rotate(-29.9deg);
    }
    37.06% {
      transform: translate(85.35cqw, 31.29cqh) rotate(-21.8deg);
    }
    38.33% {
      transform: translate(89.75cqw, 28.89cqh) rotate(-15.9deg);
    }
    39.61% {
      transform: translate(94.29cqw, 27.05cqh) rotate(-12.4deg);
    }
    40.89% {
      transform: translate(98.93cqw, 25.55cqh) rotate(-10.3deg);
    }
    42.17% {
      transform: translate(103.64cqw, 24.23cqh) rotate(-9.4deg);
    }
    43.44% {
      transform: translate(108.39cqw, 22.96cqh) rotate(-9.4deg);
    }
    44.72% {
      transform: translate(113.19cqw, 21.60cqh) rotate(-10.5deg);
    }
    46.00%,
    100% {
      transform: translate(118.00cqw, 20.00cqh) rotate(-12.7deg);
    }
  }

  @keyframes rocket-fly-narrow {
    0.00% {
      transform: translate(-30.00cqw, 71.00cqh) rotate(-10.2deg);
    }
    1.28% {
      transform: translate(-26.65cqw, 70.73cqh) rotate(-10.4deg);
    }
    2.56% {
      transform: translate(-23.25cqw, 70.46cqh) rotate(-10.5deg);
    }
    3.83% {
      transform: translate(-19.81cqw, 70.18cqh) rotate(-10.6deg);
    }
    5.11% {
      transform: translate(-16.32cqw, 69.89cqh) rotate(-10.6deg);
    }
    6.39% {
      transform: translate(-12.78cqw, 69.60cqh) rotate(-10.6deg);
    }
    7.67% {
      transform: translate(-9.20cqw, 69.31cqh) rotate(-10.5deg);
    }
    8.94% {
      transform: translate(-5.57cqw, 69.02cqh) rotate(-10.3deg);
    }
    10.22% {
      transform: translate(-1.89cqw, 68.73cqh) rotate(-10.1deg);
    }
    11.50% {
      transform: translate(1.84cqw, 68.44cqh) rotate(-9.7deg);
    }
    12.78% {
      transform: translate(5.61cqw, 68.17cqh) rotate(-9.2deg);
    }
    14.06% {
      transform: translate(9.45cqw, 67.90cqh) rotate(-8.4deg);
    }
    15.33% {
      transform: translate(13.33cqw, 67.67cqh) rotate(-7.5deg);
    }
    16.61% {
      transform: translate(17.28cqw, 67.45cqh) rotate(-6.8deg);
    }
    17.89% {
      transform: translate(21.27cqw, 67.25cqh) rotate(-6.6deg);
    }
    19.17% {
      transform: translate(25.31cqw, 67.04cqh) rotate(-6.9deg);
    }
    20.44% {
      transform: translate(29.39cqw, 66.81cqh) rotate(-7.9deg);
    }
    21.72% {
      transform: translate(33.50cqw, 66.54cqh) rotate(-9.4deg);
    }
    23.00% {
      transform: translate(37.63cqw, 66.18cqh) rotate(-12.9deg);
    }
    24.28% {
      transform: translate(41.76cqw, 65.73cqh) rotate(-14.6deg);
    }
    25.56% {
      transform: translate(45.92cqw, 65.26cqh) rotate(-14.2deg);
    }
    26.83% {
      transform: translate(50.16cqw, 64.83cqh) rotate(-11.2deg);
    }
    28.11% {
      transform: translate(54.50cqw, 64.55cqh) rotate(-5.4deg);
    }
    29.39% {
      transform: translate(58.94cqw, 64.51cqh) rotate(3.4deg);
    }
    30.67% {
      transform: translate(63.39cqw, 64.75cqh) rotate(9.5deg);
    }
    31.94% {
      transform: translate(67.86cqw, 65.10cqh) rotate(10.3deg);
    }
    33.22% {
      transform: translate(72.39cqw, 65.41cqh) rotate(6.4deg);
    }
    34.50% {
      transform: translate(77.01cqw, 65.51cqh) rotate(-0.7deg);
    }
    35.78% {
      transform: translate(81.68cqw, 65.38cqh) rotate(-5.9deg);
    }
    37.06% {
      transform: translate(86.36cqw, 65.11cqh) rotate(-8.9deg);
    }
    38.33% {
      transform: translate(91.06cqw, 64.75cqh) rotate(-10.8deg);
    }
    39.61% {
      transform: translate(95.78cqw, 64.33cqh) rotate(-12.0deg);
    }
    40.89% {
      transform: translate(100.53cqw, 63.87cqh) rotate(-12.7deg);
    }
    42.17% {
      transform: translate(105.32cqw, 63.40cqh) rotate(-12.9deg);
    }
    43.44% {
      transform: translate(110.16cqw, 62.91cqh) rotate(-12.7deg);
    }
    44.72% {
      transform: translate(115.05cqw, 62.44cqh) rotate(-12.1deg);
    }
    46.00%,
    100% {
      transform: translate(120.00cqw, 62.00cqh) rotate(-10.9deg);
    }
  }

  @media (max-width: 48rem) {
    .rocket-flight {
      width: 60px;
      animation-name: rocket-fly-narrow;
    }
  }

  /* Two out-of-phase wobbles on top of the flight path. */
  @keyframes rocket-bob {
    from {
      transform: translateY(-0.8cqh) rotate(-3deg);
    }
    to {
      transform: translateY(0.8cqh) rotate(3deg);
    }
  }

  @keyframes rocket-sway {
    from {
      translate: -0.6cqw 0;
    }
    to {
      translate: 0.6cqw 0;
    }
  }

  @keyframes rocket-flame {
    from {
      transform: scaleX(0.82) scaleY(0.92);
    }
    to {
      transform: scaleX(1.08) scaleY(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rocket-track {
      display: none;
    }
  }
</style>
