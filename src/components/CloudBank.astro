<style>
  .cloud-bank {
    display: block;
    width: 100%;
  }

  .cloud-bank :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .cloud-bank :global(.cb-back) {
    animation: cb-drift-back 34s ease-in-out infinite alternate;
  }

  .cloud-bank :global(.cb-front) {
    animation: cb-drift-front 26s ease-in-out infinite alternate;
  }

  @keyframes cb-drift-back {
    from { transform: translateX(0); }
    to { transform: translateX(-16px); }
  }

  @keyframes cb-drift-front {
    from { transform: translateX(0); }
    to { transform: translateX(14px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cloud-bank :global(.cb-back),
    .cloud-bank :global(.cb-front) {
      animation: none;
    }
  }
</style>
