---
interface Props {
  title?: string;
  url?: string;
  image?: string;
  wide?: boolean;
  /** "contain" shows the whole image (e.g. a logo) centred with padding. */
  fit?: "cover" | "contain";
  /** Card background behind a contained image. */
  background?: string;
}

const { title, url, image, wide = false, fit = "cover", background } = Astro.props;
const external = url && /^https?:\/\//.test(url);
const host = url
  ? /github\.com/.test(url)
    ? "GitHub"
    : external
      ? "Live site"
      : "Read more"
  : undefined;

const Tag = url ? "a" : "div";
---

<article
  class:list={[
    "work-card",
    wide && "work-card--wide",
    !title && "work-card--empty",
    title && !image && "work-card--no-image",
  ]}
>
  <Tag
    class="work-card-inner"
    {...(url && { href: url })}
    {...(external && { target: "_blank", rel: "noopener noreferrer" })}
    style={background ? `background: ${background}` : undefined}
  >
    {image ? <img
          class:list={["work-card-image", fit === "contain" && "work-card-image--contain"]}
          src={image}
          alt=""
          loading="lazy"
        /> : null}
    {
      title ? (
        <div class="work-card-caption">
          <h3 class="work-card-title text-h4 font-semibold">{title}</h3>
          {host ? (
            <span class="work-card-host text-h5">
              {host} <span aria-hidden="true">↗</span>
            </span>
          ) : null}
        </div>
      ) : null
    }
  </Tag>
</article>

<style>
  /* The white card is a frame; the image and caption sit inset within it. */
  .work-card {
    display: flex;
    aspect-ratio: 1 / 1;
    padding: clamp(0.4rem, 0.8vw, 0.625rem);
    background: var(--color-frame);
  }

  .work-card--empty {
    background: rgb(255 255 255 / 0.08);
  }

  .work-card-inner {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    background: var(--color-dark-purple);
    color: inherit;
    text-decoration: none;
  }

  /* Projects without a screenshot get a sunset sky from the volcano scene. */
  .work-card--no-image .work-card-inner {
    background:
      radial-gradient(circle at 78% 30%, #f2d8a7 0 7%, transparent 7.5%),
      radial-gradient(120% 90% at 50% 110%, #e39a84 0%, #bf3a6b 35%, transparent 70%),
      linear-gradient(to bottom, #22275f, #4f4791);
  }

  .work-card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-card-image--contain {
    object-fit: contain;
    padding: 18% 18% 28%;
  }

  /* Spans two squares; height comes from the square beside it. */
  .work-card--wide {
    grid-column: span 2;
    aspect-ratio: auto;
  }

  .work-card-caption {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 3.5rem 1.1rem 0.9rem;
    background: linear-gradient(to top, rgb(13 12 43 / 0.85), transparent);
  }

  .work-card-title {
    color: var(--color-frame);
    line-height: 1.15;
  }

  .work-card-host {
    flex-shrink: 0;
    padding: 0.15rem 0.65rem;
    border-radius: 999px;
    background: var(--color-frame);
    color: var(--color-dark-purple);
    font-weight: 600;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .work-card:hover .work-card-host,
  .work-card:focus-within .work-card-host {
    background: var(--color-accent);
    color: var(--color-dark-purple);
  }

  @media (max-width: 640px) {
    .work-card-host {
      display: none;
    }

    .work-card-caption {
      padding: 2.5rem 0.7rem 0.6rem;
    }
  }
</style>
