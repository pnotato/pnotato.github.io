---
interface Props {
  layer: "back" | "front";
  class?: string;
}

const { layer, class: className } = Astro.props;

type Side = "left" | "right";
type Pt = [number, number];

// Units are px at full size, matching the 512px-wide volcano. Distances are
// measured outward from the page centre; heights include the 20px under the frame.
const W = 1800;
const H = 140;
// Matches the volcano's outline weight at full size.
const RIM = 8;

// Ridge key points as [distance from centre, height]. Back peaks must stay
// below the volcano crater (~133).
const KEYS: Record<typeof layer, Record<Side, Pt[]>> = {
  back: {
    left: [
      [0, 80], [130, 94], [240, 84], [330, 98], [430, 112], [520, 88],
      [590, 96], [680, 62], [770, 88], [850, 58], [940, 82], [1020, 70],
      [1110, 48], [1220, 78], [1330, 56], [1420, 68], [1540, 42], [1660, 62],
      [W, 52],
    ],
    right: [
      [0, 80], [150, 90], [260, 82], [360, 100], [450, 76], [530, 92],
      [620, 56], [720, 90], [800, 68], [880, 78], [980, 52], [1080, 80],
      [1180, 60], [1280, 68], [1400, 44], [1520, 72], [1660, 48], [W, 60],
    ],
  },
  front: {
    left: [
      [0, 30], [90, 40], [180, 33], [270, 52], [360, 38], [450, 60],
      [560, 36], [650, 44], [740, 56], [860, 30], [980, 58], [1100, 36],
      [1220, 46], [1320, 54], [1460, 30], [1620, 50], [W, 38],
    ],
    right: [
      [0, 30], [100, 38], [200, 31], [300, 50], [400, 36], [500, 40],
      [580, 60], [700, 34], [800, 50], [920, 30], [1060, 56], [1180, 38],
      [1320, 54], [1480, 32], [1640, 50], [W, 40],
    ],
  },
};

// Colours are drawn from the volcano: lavender on its lit left face, navy on its right.
const PALETTES: Record<typeof layer, Record<Side, { rim: string; tones: string[]; fill: [string, string] }>> = {
  back: {
    left: { rim: "#B3AEF5", tones: ["#7063CA", "#6459BA", "#574EA6", "#4F4791"], fill: ["#4F4791", "#3C3A79"] },
    right: { rim: "#7164BE", tones: ["#4A4DB5", "#3F43A0", "#373B8D", "#313580"], fill: ["#313580", "#2B2F74"] },
  },
  front: {
    left: { rim: "#7164BE", tones: ["#4F4791", "#453F86", "#3C3A79", "#34326C"], fill: ["#34326C", "#2A285A"] },
    right: { rim: "#4A4DB5", tones: ["#313580", "#2B3078", "#262A6C", "#21255F"], fill: ["#262A6C", "#1E2256"] },
  },
};

function rng(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function ridge(keys: Pt[], seed: number): Pt[] {
  const r = rng(seed);
  const out: Pt[] = [[-4, keys[0][1]], keys[0]];
  for (let i = 0; i < keys.length - 1; i++) {
    const [d0, h0] = keys[i];
    const [d1, h1] = keys[i + 1];
    const n = Math.max(1, Math.round((d1 - d0) / 42));
    for (let j = 1; j < n; j++) {
      const t = j / n + ((r() - 0.5) * 0.4) / n;
      out.push([d0 + (d1 - d0) * t, h0 + (h1 - h0) * t + (r() - 0.5) * 14]);
    }
    out.push(keys[i + 1]);
  }
  return out;
}

const f = (n: number) => n.toFixed(1);
const pts = (p: Pt[]) => p.map(([x, y]) => `${f(x)},${f(y)}`).join(" ");

function build(side: Side, seed: number) {
  const top: Pt[] = ridge(KEYS[layer][side], seed).map(([d, h]) => [side === "left" ? W - d : d, H - h]);
  if (side === "left") top.reverse();

  const r = rng(seed * 7 + 3);
  const { tones } = PALETTES[layer][side];
  const level = (a: Pt, b: Pt) => {
    const s = (a[1] - b[1]) / (b[0] - a[0]);
    return s > 0.45 ? 0 : s > 0.1 ? 1 : s > -0.1 ? 2 : 3;
  };

  const lows: Pt[] = [];
  const levels: number[] = [];
  for (let i = 0; i < top.length - 1; i++) {
    const [a, b] = [top[i], top[i + 1]];
    const depth = layer === "back" ? 20 + r() * 16 : 12 + r() * 10;
    lows.push([(a[0] + b[0]) / 2 + (r() - 0.5) * 8, Math.max(a[1], b[1]) + depth]);
    levels.push(level(a, b));
  }

  const facets: { points: string; fill: string }[] = [];
  for (let i = 0; i < lows.length; i++) {
    facets.push({ points: pts([top[i], top[i + 1], lows[i]]), fill: tones[levels[i]] });
    if (i < lows.length - 1) {
      const lv = Math.min(3, Math.round((levels[i] + levels[i + 1]) / 2) + 1);
      facets.push({ points: pts([lows[i], top[i + 1], lows[i + 1]]), fill: tones[lv] });
    }
  }

  const outline = `M${top.map(([x, y]) => `${f(x)} ${f(y)}`).join(" L")} L${f(top.at(-1)![0])} ${H} L${f(top[0][0])} ${H} Z`;
  const rim = pts(top);
  return { outline, facets, rim };
}

const halves = (["left", "right"] as const).map((side, i) => ({
  side,
  id: `jh-${layer}-${side}`,
  palette: PALETTES[layer][side],
  ...build(side, (layer === "back" ? 11 : 29) + i * 13),
}));
---

<div class:list={["jagged-hills", `jagged-hills-${layer}`, className]} aria-hidden="true">
  {
    halves.map(({ side, id, palette, outline, facets, rim }) => (
      <svg
        viewBox={`0 0 ${W} ${H}`}
        preserveAspectRatio={side === "left" ? "xMaxYMax slice" : "xMinYMax slice"}
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <linearGradient id={`${id}-fill`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color={palette.fill[0]} />
            <stop offset="1" stop-color={palette.fill[1]} />
          </linearGradient>
        </defs>
        <path d={outline} fill={`url(#${id}-fill)`} />
        {facets.map((t) => (
          <polygon points={t.points} fill={t.fill} />
        ))}
        <polyline
          points={rim}
          fill="none"
          stroke={palette.rim}
          stroke-width={RIM}
          stroke-linejoin="round"
          stroke-linecap="round"
        />
      </svg>
    ))
  }
</div>

<style define:vars={{ hillsHeight: H }}>
  .jagged-hills {
    display: flex;
    width: 100%;
    height: min(
      calc(var(--hillsHeight) * 1px),
      calc((100vw - 2 * var(--frame-width)) * var(--hillsHeight) / 512)
    );
  }

  .jagged-hills svg {
    display: block;
    flex: 1 1 50%;
    min-width: 0;
    height: 100%;
    overflow: visible;
  }
</style>
