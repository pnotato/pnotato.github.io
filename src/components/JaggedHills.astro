---
interface Props {
  layer: "back" | "front";
  class?: string;
}

const { layer, class: className } = Astro.props;

type Side = "left" | "right";
type Pt = [number, number];

// Units are px at full size, matching the 576px-wide volcano. Distances are
// measured outward from the page centre; heights include the 20px under the frame.
const W = 1800;
const H = 140;

// Ridge key points as [distance from centre, height]. Back peaks must stay
// below the volcano crater (~173).
const KEYS: Record<typeof layer, Record<Side, Pt[]>> = {
  back: {
    left: [
      [0, 80], [130, 94], [240, 84], [330, 98], [430, 112], [520, 88],
      [590, 96], [680, 62], [770, 88], [850, 58], [940, 82], [1020, 70],
      [1110, 48], [1220, 78], [1330, 56], [1420, 68], [1540, 42], [1660, 62],
      [W, 52],
    ],
    right: [
      [0, 80], [150, 90], [260, 82], [360, 100], [450, 76], [530, 92],
      [620, 56], [720, 90], [800, 68], [880, 78], [980, 52], [1080, 80],
      [1180, 60], [1280, 68], [1400, 44], [1520, 72], [1660, 48], [W, 60],
    ],
  },
  front: {
    left: [
      [0, 30], [90, 40], [180, 33], [270, 52], [360, 38], [450, 60],
      [560, 36], [650, 44], [740, 56], [860, 30], [980, 58], [1100, 36],
      [1220, 46], [1320, 54], [1460, 30], [1620, 50], [W, 38],
    ],
    right: [
      [0, 30], [100, 38], [200, 31], [300, 50], [400, 36], [500, 40],
      [580, 60], [700, 34], [800, 50], [920, 30], [1060, 56], [1180, 38],
      [1320, 54], [1480, 32], [1640, 50], [W, 40],
    ],
  },
};

// Colours are drawn from the volcano and shade left to right like its faces:
// lavender where lit on the left, navy on the right.
type Tone = { rim: string; glint: string; face: string; fill: string };
type Style = { lit: Tone; dark: Tone; rimWidth: number; step: number; jitter: number; smooth: boolean; corner: number };
const PALETTES: Record<typeof layer, Style> = {
  back: {
    lit: { rim: "#B3AEF5", glint: "#B3AEF5", face: "#7063CA", fill: "#5A4FB0" },
    dark: { rim: "#2E347F", glint: "#4A4DB5", face: "#353A8E", fill: "#2B2F74" },
    // Matches the volcano's line weight at full size.
    rimWidth: 9,
    step: 42,
    jitter: 14,
    smooth: false,
    corner: 10,
  },
  front: {
    lit: { rim: "#8F87E8", glint: "#9F99FF", face: "#5E54B0", fill: "#4F4791" },
    dark: { rim: "#4A4DB5", glint: "#4A4DB5", face: "#2B3078", fill: "#22275F" },
    rimWidth: 2.5,
    step: 60,
    jitter: 9,
    smooth: false,
    corner: 18,
  },
};
// Signed distance from centre over which the shading runs from lit to dark; kept
// short so the split lines up with the volcano's own light and dark faces.
const SPAN = 220;

const hex = (c: string) => [1, 3, 5].map((i) => parseInt(c.slice(i, i + 2), 16));
const mix = (a: string, b: string, t: number) =>
  "#" + hex(a).map((v, i) => Math.round(v + (hex(b)[i] - v) * t).toString(16).padStart(2, "0")).join("");
const shadeAt = (s: number) => Math.min(1, Math.max(0, (s + SPAN) / (2 * SPAN)));

function rng(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function ridge(keys: Pt[], seed: number, step: number, jitter: number): Pt[] {
  const r = rng(seed);
  const out: Pt[] = [[-4, keys[0][1]], keys[0]];
  for (let i = 0; i < keys.length - 1; i++) {
    const [d0, h0] = keys[i];
    const [d1, h1] = keys[i + 1];
    const n = Math.max(1, Math.round((d1 - d0) / step));
    for (let j = 1; j < n; j++) {
      const t = j / n + ((r() - 0.5) * 0.4) / n;
      out.push([d0 + (d1 - d0) * t, h0 + (h1 - h0) * t + (r() - 0.5) * jitter]);
    }
    out.push(keys[i + 1]);
  }
  return out;
}

const f = (n: number) => n.toFixed(1);
const pts = (p: Pt[]) => p.map(([x, y]) => `${f(x)},${f(y)}`).join(" ");
// Polyline with each corner eased into a short quadratic curve.
function roundedLine(p: Pt[], radius: number) {
  let d = `M${f(p[0][0])} ${f(p[0][1])}`;
  const toward = (from: Pt, to: Pt): Pt => {
    const len = Math.hypot(to[0] - from[0], to[1] - from[1]);
    const k = Math.min(radius, len / 2) / len;
    return [from[0] + (to[0] - from[0]) * k, from[1] + (to[1] - from[1]) * k];
  };
  for (let i = 1; i < p.length - 1; i++) {
    const [a, b] = [toward(p[i], p[i - 1]), toward(p[i], p[i + 1])];
    d += ` L${f(a[0])} ${f(a[1])} Q${f(p[i][0])} ${f(p[i][1])} ${f(b[0])} ${f(b[1])}`;
  }
  return `${d} L${f(p.at(-1)![0])} ${f(p.at(-1)![1])}`;
}

// Catmull-Rom spline through the points, as cubic Beziers.
function segments(p: Pt[]) {
  return p.slice(0, -1).map((p1, i) => {
    const [p0, p2, p3] = [p[i - 1] ?? p1, p[i + 1], p[i + 2] ?? p[i + 1]];
    const c1: Pt = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2: Pt = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    return [p1, c1, c2, p2] as const;
  });
}

function curveThrough(p: Pt[]) {
  return `M${f(p[0][0])} ${f(p[0][1])}` + segments(p).map(([, c1, c2, p2]) => ` C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${f(p2[0])} ${f(p2[1])}`).join("");
}

// Points along the spline, so facets on a smooth ridge follow its curve.
function sampleCurve(p: Pt[], perSegment: number): Pt[] {
  const out: Pt[] = [p[0]];
  for (const [a, b, c, d] of segments(p)) {
    for (let j = 1; j <= perSegment; j++) {
      const t = j / perSegment;
      const u = 1 - t;
      const w = [u * u * u, 3 * u * u * t, 3 * u * t * t, t * t * t];
      out.push([0, 1].map((k) => w[0] * a[k] + w[1] * b[k] + w[2] * c[k] + w[3] * d[k]) as Pt);
    }
  }
  return out;
}

function build(side: Side, seed: number) {
  const { lit, dark, step, jitter, smooth, corner } = PALETTES[layer];
  const top: Pt[] = ridge(KEYS[layer][side], seed, step, jitter).map(([d, h]) => [side === "left" ? W - d : d, H - h]);
  if (side === "left") top.reverse();

  const r = rng(seed * 7 + 3);
  const toSigned = (x: number) => (side === "left" ? x - W : x);
  // Slope only nudges the positional shade, so each side stays one consistent tone.
  const facetFill = (x: number, slope: number) => {
    const t = shadeAt(toSigned(x));
    const face = mix(mix(lit.face, dark.face, t), mix(lit.fill, dark.fill, t), r() * 0.3);
    if (slope > 0.3) return mix(face, mix(lit.glint, dark.glint, t), 0.22);
    if (slope < -0.1) return mix(face, mix(lit.fill, dark.fill, t), 0.5);
    return face;
  };
  const slopeOf = (a: Pt, b: Pt) => (a[1] - b[1]) / (b[0] - a[0]);

  const edge = smooth ? sampleCurve(top, 3) : top;
  const lows: Pt[] = [];
  for (let i = 0; i < edge.length - 1; i++) {
    const [a, b] = [edge[i], edge[i + 1]];
    const depth = layer === "back" ? 20 + r() * 16 : 12 + r() * 10;
    lows.push([(a[0] + b[0]) / 2 + (r() - 0.5) * 8, Math.max(a[1], b[1]) + depth]);
  }

  const facets: { points: string; fill: string }[] = [];
  for (let i = 0; i < lows.length; i++) {
    const [a, b] = [edge[i], edge[i + 1]];
    facets.push({ points: pts([a, b, lows[i]]), fill: facetFill((a[0] + b[0]) / 2, slopeOf(a, b)) });
    if (i < lows.length - 1) {
      const slope = (slopeOf(a, b) + slopeOf(b, edge[i + 2])) / 2 - 0.2;
      facets.push({ points: pts([lows[i], b, lows[i + 1]]), fill: facetFill(b[0], slope) });
    }
  }

  const rim = smooth ? curveThrough(top) : roundedLine(top, corner);
  const outline = `${rim} L${f(top.at(-1)![0])} ${H} L${f(top[0][0])} ${H} Z`;
  // Horizontal gradient endpoints in this half's own coordinates.
  const [gx1, gx2] = side === "left" ? [W - SPAN, W + SPAN] : [-SPAN, SPAN];
  return { outline, facets, rim, gx1, gx2 };
}

const palette = PALETTES[layer];
const rimStops: { offset: string; color: string }[] =
  layer === "front"
    ? [
        { offset: "0", color: palette.lit.rim },
        { offset: "0.4", color: palette.dark.rim },
        { offset: "1", color: mix(palette.dark.rim, "#181743", 0.7) },
      ]
    : [
        { offset: "0", color: palette.lit.rim },
        { offset: "1", color: palette.dark.rim },
      ];
const halves = (["left", "right"] as const).map((side, i) => ({
  side,
  id: `jh-${layer}-${side}`,
  ...build(side, (layer === "back" ? 11 : 29) + i * 13),
}));
---

<div class:list={["jagged-hills", `jagged-hills-${layer}`, className]} aria-hidden="true">
  {
    halves.map(({ side, id, outline, facets, rim, gx1, gx2 }) => (
      <svg
        viewBox={`0 0 ${W} ${H}`}
        preserveAspectRatio={side === "left" ? "xMaxYMax slice" : "xMinYMax slice"}
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <linearGradient id={`${id}-fill`} gradientUnits="userSpaceOnUse" x1={gx1} y1="0" x2={gx2} y2="0">
            <stop offset="0" stop-color={palette.smooth ? palette.lit.face : palette.lit.fill} />
            <stop offset="1" stop-color={palette.smooth ? palette.dark.face : palette.dark.fill} />
          </linearGradient>
          <linearGradient id={`${id}-rim`} gradientUnits="userSpaceOnUse" x1={gx1} y1="0" x2={gx2} y2="0">
            {rimStops.map((s) => (
              <stop offset={s.offset} stop-color={s.color} />
            ))}
          </linearGradient>
          <clipPath id={`${id}-clip`}>
            <path d={outline} />
          </clipPath>
        </defs>
        <path d={outline} fill={`url(#${id}-fill)`} />
        <g clip-path={`url(#${id}-clip)`}>
          {facets.map((t) => (
            <polygon points={t.points} fill={t.fill} />
          ))}
        </g>
        <path
          d={rim}
          fill="none"
          stroke={`url(#${id}-rim)`}
          stroke-width={palette.rimWidth}
          stroke-linejoin="round"
          stroke-linecap="round"
        />
      </svg>
    ))
  }
</div>

<style define:vars={{ hillsHeight: H }}>
  .jagged-hills {
    display: flex;
    width: 100%;
    height: min(
      calc(var(--hillsHeight) * 1px),
      calc((100vw - 2 * var(--frame-width)) * var(--hillsHeight) / 576)
    );
  }

  .jagged-hills svg {
    display: block;
    flex: 1 1 50%;
    min-width: 0;
    height: 100%;
    overflow: visible;
  }
</style>
