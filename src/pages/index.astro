---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BarPlanet from "@/components/BarPlanet.astro";
import Volcano from "@/components/Volcano.astro";

const SECTION_HEIGHT = "min-h-[calc(100dvh-2*var(--frame-width))]";
---

<BaseLayout>
  <section
    class:list={[
      "relative flex flex-1 flex-col items-center justify-center gap-14 px-8 py-16 md:flex-row md:gap-16 md:px-16",
      SECTION_HEIGHT,
    ]}
  >
    <div
      data-starfield-exclude
      class="flex max-w-2xl flex-col gap-5 bg-dark-purple text-center md:max-w-[40%] md:text-left"
    >
      <h1 class="text-h1 font-extrabold">
        Hi, I'm <span
          class="bg-linear-to-b from-ember via-flare to-accent bg-clip-text text-transparent"
          >Nick</span
        >.
      </h1>
      <h2 class="text-h2 font-normal">
        A final year computer science student at Simon Fraser University.
      </h2>
      <h2 class="text-h2 font-normal">
        I'm a software engineer interested in scalable systems, distributed
        computing, and machine learning!
      </h2>
      <ul
        class="text-h3 mt-1 flex flex-wrap justify-center gap-x-6 gap-y-2 md:justify-start"
      >
        <li>
          <a
            class="text-frame/60 transition-colors hover:text-accent"
            href="https://www.linkedin.com/in/nicholasch-an/">LinkedIn</a
          >
        </li>
        <li>
          <a
            class="text-frame/60 transition-colors hover:text-accent"
            href="https://github.com/pnotato/">Github</a
          >
        </li>
        <li>
          <a
            class="text-frame/60 transition-colors hover:text-accent"
            href="mailto:nicholasch.an@outlook.com">Email</a
          >
        </li>
        <li>
          <a
            class="text-frame/60 transition-colors hover:text-accent"
            href="/assets/Resume_Sept_2025.pdf">Resume</a
          >
        </li>
      </ul>
    </div>
    <div class="flex flex-1 justify-center">
      <div class="planet-scene">
        <div class="planet-big">
          <BarPlanet variant="magenta" rotation="-22deg" ring />
        </div>
        <div class="planet-mini">
          <BarPlanet
            variant="blue"
            rotation="45deg"
            size="calc(var(--planet-size) * 0.34)"
          />
        </div>
      </div>
    </div>

    <a href="#next" class="scroll-hint" aria-label="Scroll to next section">
      <svg
        viewBox="0 0 24 14"
        width="30"
        height="18"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M3 3.5 L12 11.5 L21 3.5"
          stroke="currentColor"
          stroke-width="2.75"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </section>

  <section
    id="next"
    aria-label="Next section"
    class:list={[SECTION_HEIGHT, "relative scroll-mt-[var(--frame-width)]"]}
  >
    <div
      class="pointer-events-none absolute -bottom-[var(--frame-width)] left-1/2 w-full max-w-lg -translate-x-1/2"
      aria-hidden="true"
    >
      <Volcano />
    </div>
  </section>
</BaseLayout>

<style>
  .planet-scene {
    --planet-size: clamp(200px, 46vmin, 460px);
    position: relative;
    isolation: isolate;
    transform: translate(6%, 14%);
  }

  .planet-big {
    position: relative;
    z-index: 2;
  }

  .planet-mini {
    position: absolute;
    left: -19%;
    top: -29%;
    z-index: 1;
  }

  .scroll-hint {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    color: var(--color-frame);
    opacity: 0.25;
    transform: translateX(-50%);
    animation: scroll-hint 1.8s ease-in-out infinite;
    transition: opacity 0.2s ease;
  }

  .scroll-hint:hover {
    opacity: 0.6;
  }

  @keyframes scroll-hint {
    0%,
    100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, 7px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint {
      animation: none;
    }
  }
</style>
