---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BarPlanet from "@/components/BarPlanet.astro";
import Volcano from "@/components/Volcano.astro";
import JaggedHills from "@/components/JaggedHills.astro";
import EXPERIENCES_DATA from "@/data/experiences.json";
import { SITE } from "@/consts";
const SECTION_HEIGHT = "min-h-[calc(100dvh-2*var(--frame-width))]";
const year = new Date().getFullYear();
const { title, experiences } = EXPERIENCES_DATA as {
  title: string;
  experiences: { left: string; right?: string; subtext?: string }[];
};
---

<BaseLayout>
  <section
    class:list={[
      "relative flex flex-1 flex-col items-center justify-center gap-14 px-8 py-16 md:flex-row md:gap-16 md:px-16",
      SECTION_HEIGHT,
    ]}
  >
    <div
      data-starfield-exclude
      class="flex max-w-2xl flex-col gap-5 bg-dark-purple text-center md:max-w-[40%] md:text-left"
    >
      <h1 class="text-h1 font-extrabold">
        Hi, I'm <span
          class="bg-linear-to-b from-ember via-flare to-accent bg-clip-text text-transparent"
          >Nick</span
        >.
      </h1>
      <h2 class="text-h2 font-normal">
        A final year computer science student at Simon Fraser University.
      </h2>
      <h2 class="text-h2 font-normal">
        I'm a software engineer interested in scalable systems, distributed
        computing, and machine learning!
      </h2>
      <ul
        class="text-body mt-1 flex flex-wrap justify-center gap-x-6 gap-y-2 md:justify-start"
      >
        <li>
          <a
            class="text-frame/60 transition-colors hover:text-accent"
            href="https://www.linkedin.com/in/nicholasch-an/">LinkedIn</a
          >
        </li>
        <li>
          <a
            class="text-frame/60 transition-colors hover:text-accent"
            href="https://github.com/pnotato/">Github</a
          >
        </li>
        <li>
          <a
            class="text-frame/60 transition-colors hover:text-accent"
            href="mailto:nicholasch.an@outlook.com">Email</a
          >
        </li>
        <li>
          <a
            class="text-frame/60 transition-colors hover:text-accent"
            href="/assets/Resume_Sept_2025.pdf">Resume</a
          >
        </li>
      </ul>
    </div>
    <div class="flex flex-1 justify-center">
      <div class="planet-scene">
        <div class="planet-big">
          <BarPlanet variant="magenta" rotation="-22deg" ring />
        </div>
        <div class="planet-mini">
          <BarPlanet
            variant="blue"
            rotation="45deg"
            size="calc(var(--planet-size) * 0.34)"
          />
        </div>
      </div>
    </div>

    <a href="#next" class="scroll-hint" aria-label="Scroll to next section">
      <svg
        viewBox="0 0 24 14"
        width="30"
        height="18"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M3 3.5 L12 11.5 L21 3.5"
          stroke="currentColor"
          stroke-width="2.75"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </section>

  <section
    id="next"
    aria-label="Next section"
    class="next-pin scroll-mt-[var(--frame-width)]"
    style={`--next-steps:${experiences.length}`}
  >
    <div class="next-stage">
      <div
        class="sunset-glow pointer-events-none absolute inset-x-0 bottom-0"
        aria-hidden="true"
      ></div>
      <div class="next-phrases pointer-events-none">
        <h2 class="next-title text-h2">{title}</h2>
        <div class="next-phrase-list">
          {
            experiences.map(({ left, right, subtext }) => (
              <div
                class:list={[
                  "next-phrase text-h3",
                  !right && "next-phrase--center",
                ]}
              >
                <h2 class="next-phrase-main font-bold">
                  <span>{left}</span>
                  {right ? <span>{right}</span> : null}
                </h2>
                {subtext ? (
                  <p class="next-phrase-sub text-h4">{subtext}</p>
                ) : null}
              </div>
            ))
          }
        </div>
      </div>
      <div
        class="pointer-events-none absolute inset-x-0 -bottom-[var(--frame-width)]"
        aria-hidden="true"
      >
        <JaggedHills layer="back" />
      </div>
      <div
        class="pointer-events-none absolute bottom-[calc(12px-var(--frame-width))] left-1/2 w-full max-w-[36rem] -translate-x-1/2"
        aria-hidden="true"
      >
        <Volcano class="origin-bottom scale-y-108" />
      </div>
      <div
        class="pointer-events-none absolute inset-x-0 -bottom-[var(--frame-width)]"
        aria-hidden="true"
      >
        <JaggedHills layer="front" />
      </div>
    </div>
  </section>

  <footer
    id="next-2"
    aria-label="Footer"
    class:list={[
      "next-final relative flex min-h-[27vh] flex-col justify-between gap-5 px-8 pt-12 pb-6 md:px-16",
    ]}
  >
    <div
      class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between"
    >
      <div class="flex max-w-sm flex-col gap-2">
        <a
          href="/"
          class="text-body font-extrabold text-frame transition-colors hover:text-accent"
          >{SITE.title}</a
        >
        <p class="text-h5 text-frame/60">
          A final year computer science student at Simon Fraser University.
        </p>
      </div>
      <div class="flex flex-col gap-4 sm:flex-row sm:gap-16">
        <div class="flex flex-col gap-2">
          <h3
            class="text-h5 font-semibold tracking-widest text-frame/40 uppercase"
          >
            Connect
          </h3>
          <ul class="text-body flex flex-col gap-2">
            <li>
              <a
                class="text-frame/70 transition-colors hover:text-accent"
                href="https://www.linkedin.com/in/nicholasch-an/">LinkedIn</a
              >
            </li>
            <li>
              <a
                class="text-frame/70 transition-colors hover:text-accent"
                href="mailto:nicholasch.an@outlook.com">Email</a
              >
            </li>
          </ul>
        </div>
        <div class="flex flex-col gap-2">
          <h3
            class="text-h5 font-semibold tracking-widest text-frame/40 uppercase"
          >
            Explore
          </h3>
          <ul class="text-body flex flex-col gap-2">
            <li>
              <a
                class="text-frame/70 transition-colors hover:text-accent"
                href="/assets/Resume_Sept_2025.pdf">Resume</a
              >
            </li>
            <li>
              <a
                class="text-frame/70 transition-colors hover:text-accent"
                href="https://github.com/pnotato/">Github</a
              >
            </li>
          </ul>
        </div>
        <div class="flex flex-col gap-2">
          <h3
            class="text-h5 font-semibold tracking-widest text-frame/40 uppercase"
          >
            Site
          </h3>
          <ul class="text-body flex flex-col gap-2">
            <li>
              <a
                class="text-frame/70 transition-colors hover:text-accent"
                href="#">Portfolio</a
              >
            </li>
            <li>
              <a
                class="text-frame/70 transition-colors hover:text-accent"
                href="#">Writing</a
              >
            </li>
          </ul>
        </div>
      </div>
    </div>
    <div
      class="text-h5 flex flex-col gap-2 border-t border-frame/15 pt-3 text-frame/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {SITE.title}. All rights reserved.</p>
      <a class="transition-colors hover:text-accent" href="#">Back to top ↑</a>
    </div>
  </footer>
</BaseLayout>

<style>
  .next-pin {
    --next-step: 70vh;
    position: relative;
    z-index: 2;
    height: calc(
      100dvh - 2 * var(--frame-width) +
        (var(--next-steps) - 1) * var(--next-step)
    );
  }

  .next-final {
    background:
      linear-gradient(
        to bottom,
        rgba(34, 39, 95, 0) 0%,
        rgba(34, 39, 95, 0.55) 55%,
        #22275f 100%
      ),
      linear-gradient(
        to right,
        #4f4791 0%,
        #4f4791 calc(50% - 220px),
        #22275f calc(50% + 220px),
        #22275f 100%
      );
  }

  .next-stage {
    position: sticky;
    top: var(--frame-width);
    height: calc(100dvh - 2 * var(--frame-width));
  }

  .next-phrases {
    --phrase-gap: 6rem;
    --phrase-top: 34%;
    position: absolute;
    inset: 0;
    z-index: 10;
  }

  .next-phrase-list {
    position: absolute;
    inset: 0;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 30%);
    mask-image: linear-gradient(to bottom, transparent, #000 30%);
  }

  .next-title {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--phrase-top) - var(--phrase-gap) - 5rem);
    transform: translateY(-50%);
    text-align: center;
  }

  .next-phrase {
    position: absolute;
    left: 50%;
    top: var(--phrase-top);
    width: 100%;
    padding: 0 5rem;
    opacity: var(--o, 0);
    transform: translate(-50%, -50%)
      translateY(calc(var(--d, 0) * var(--phrase-gap)));
    will-change: transform, opacity;
  }

  .next-phrase-main {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2rem;
    width: 100%;
    line-height: 1.15;
  }

  .next-phrase-main > span {
    flex: 1 1 0;
  }

  .next-phrase-main > span:last-child {
    text-align: right;
  }

  .next-phrase--center .next-phrase-main {
    justify-content: center;
  }

  .next-phrase--center .next-phrase-main > span {
    flex: 0 1 auto;
  }

  .next-phrase-sub {
    margin-top: 0.5rem;
    font-weight: 400;
    line-height: 1.15;
  }

  .next-phrase:nth-child(2) {
    --o: 1;
  }

  .sunset-glow {
    height: 75vh;
    background: radial-gradient(
      ellipse 100% 100% at 50% 100%,
      rgba(242, 168, 94, 0.6) 0%,
      rgba(229, 115, 56, 0.4) 50%,
      rgba(229, 115, 56, 0) 100%
    );
  }

  .planet-scene {
    --planet-size: clamp(200px, 46vmin, 460px);
    position: relative;
    isolation: isolate;
    transform: translate(6%, 14%);
  }

  .planet-big {
    position: relative;
    z-index: 2;
  }

  .planet-mini {
    position: absolute;
    left: -19%;
    top: -29%;
    z-index: 1;
  }

  .scroll-hint {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    color: var(--color-frame);
    opacity: 0.25;
    transform: translateX(-50%);
    animation: scroll-hint 1.8s ease-in-out infinite;
    transition: opacity 0.2s ease;
  }

  .scroll-hint:hover {
    opacity: 0.6;
  }

  @keyframes scroll-hint {
    0%,
    100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, 7px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint {
      animation: none;
    }
  }
</style>

<script>
  const pin = document.querySelector<HTMLElement>(".next-pin");
  const stage = pin?.querySelector<HTMLElement>(".next-stage");
  const phrases = Array.from(
    pin?.querySelectorAll<HTMLElement>(".next-phrase") ?? [],
  );

  if (pin && stage && phrases.length > 1) {
    const count = phrases.length;
    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let pinTop = 0;
    let total = 0;
    let step = 0;
    let start = 0;
    let end = 0;
    let queued = false;
    let settleTimer = 0;
    let dir = 1;
    let lastY = 0;

    const measure = () => {
      const stickyTop = parseFloat(getComputedStyle(stage).top) || 0;
      pinTop = pin.getBoundingClientRect().top + window.scrollY;
      total = pin.offsetHeight - stage.offsetHeight;
      step = total / (count - 1);
      start = pinTop - stickyTop;
      end = start + total;
      lastY = window.scrollY;
    };

    const render = () => {
      queued = false;

      const progress =
        total > 0
          ? Math.min(1, Math.max(0, (window.scrollY - start) / total))
          : 1;
      const pos = progress * (count - 1);

      phrases.forEach((phrase, i) => {
        const d = i - pos;
        const falloff = d >= 0 ? 1 - d / 3 : 1 - Math.abs(d) / 2;
        const opacity = Math.max(0, falloff) ** 2.5;
        phrase.style.setProperty("--d", d.toFixed(4));
        phrase.style.setProperty("--o", opacity.toFixed(4));
      });
    };

    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(render);
    };

    const settle = () => {
      const y = window.scrollY;
      if (y <= start + 1 || y >= end - 1) return;

      const raw = (y - start) / step;
      const index = dir > 0 ? Math.ceil(raw - 0.001) : Math.floor(raw + 0.001);
      const clamped = Math.min(count - 1, Math.max(0, index));
      const target = start + clamped * step;

      if (Math.abs(target - y) < 2) return;
      window.scrollTo({ top: target, behavior: reduce ? "auto" : "smooth" });
    };

    const onScroll = () => {
      schedule();

      const y = window.scrollY;
      if (y > lastY) dir = 1;
      else if (y < lastY) dir = -1;
      lastY = y;

      window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(settle, 140);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => {
      measure();
      schedule();
    });
    window.addEventListener("load", () => {
      measure();
      schedule();
    });

    measure();
    render();
  }
</script>
