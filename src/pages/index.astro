---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BarPlanet from "@/components/BarPlanet.astro";
import Volcano from "@/components/Volcano.astro";
import JaggedHills from "@/components/JaggedHills.astro";
import WorkGrid from "@/components/WorkGrid.astro";
import EXPERIENCES_DATA from "@/data/experiences.json";
import PROJECTS_DATA from "@/data/projects.json";
const SECTION_HEIGHT = "min-h-[calc(100dvh-2*var(--frame-width))]";
const { title, experiences } = EXPERIENCES_DATA as {
  title: string;
  experiences: {
    left: string;
    right?: string;
    subtext?: string;
    url?: string;
    details?: {
      technologies?: string;
      description?: string;
      points?: string[];
    };
  }[];
};
const DETAILS_PLACEHOLDER = {
  technologies: "Placeholder",
  description: "Placeholder — describe what you built and the impact it had.",
};
// Standalone figures like 250+, 25%, $1.2M, 3x, 1,000 (not digits inside
// words like S3 or ES6). split() with a capture group puts matches at odd
// indices.
const NUMBER_RE =
  /(?<![\w.$])(\$?\d+(?:[.,]\d+)*(?:%|\+|[xX]\b|[kKMB]\b)?\+?)(?!\w)/;
const splitNumbers = (text: string) => text.split(NUMBER_RE);
const jobs = experiences.map((job) => ({
  ...job,
  details: job.details ?? DETAILS_PLACEHOLDER,
}));
---

<BaseLayout>
  <section
    class:list={[
      "relative flex flex-1 flex-col items-center justify-center gap-14 px-8 py-16 md:flex-row md:gap-16 md:px-16",
      SECTION_HEIGHT,
    ]}
  >
    <div
      data-starfield-exclude
      class="flex max-w-2xl flex-col gap-5 bg-dark-purple text-center md:max-w-[40%] md:text-left"
    >
      <h1 class="text-h1 font-extrabold">
        Hi, I'm <span
          class="bg-linear-to-b from-ember via-flare to-accent bg-clip-text text-transparent"
          >Nick</span
        >.
      </h1>
      <h2 class="text-h2 font-normal">
        I'm a final year computer science and statistics student at Simon Fraser University.
      </h2>
      <h2 class="text-h2 font-normal">
        Take a look at <a
          class="text-cream transition-colors hover:text-accent"
          href="#next">my experiences</a
        >, check out <a
          class="text-cream transition-colors hover:text-accent"
          href="/portfolio">my projects</a
        >, or read about my work on <a
          class="text-cream transition-colors hover:text-accent"
          href="/writing">my blog</a
        >.
      </h2>
      <ul
        class="text-body mt-1 flex flex-wrap justify-center gap-x-6 gap-y-2 md:justify-start"
      >
        <li>
          <a
            class="text-frame/60 transition-colors hover:text-accent"
            href="https://www.linkedin.com/in/nicholasch-an/">LinkedIn</a
          >
        </li>
        <li>
          <a
            class="text-frame/60 transition-colors hover:text-accent"
            href="https://github.com/pnotato/">Github</a
          >
        </li>
        <li>
          <a
            class="text-frame/60 transition-colors hover:text-accent"
            href="mailto:nicholasch.an@outlook.com">Email</a
          >
        </li>
        <li>
          <a
            class="text-frame/60 transition-colors hover:text-accent"
            href="/assets/Resume_Sept_2025.pdf">Resume</a
          >
        </li>
      </ul>
    </div>
    <div class="flex flex-1 justify-center">
      <div class="planet-scene">
        <div class="planet-big">
          <BarPlanet variant="magenta" rotation="-22deg" ring />
        </div>
        <div class="planet-mini">
          <BarPlanet
            variant="blue"
            rotation="45deg"
            size="calc(var(--planet-size) * 0.34)"
          />
        </div>
      </div>
    </div>

    <a href="#next" class="scroll-hint" aria-label="Scroll to next section">
      <svg
        viewBox="0 0 24 14"
        width="30"
        height="18"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M3 3.5 L12 11.5 L21 3.5"
          stroke="currentColor"
          stroke-width="2.75"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </section>

  <section
    id="next"
    aria-label="Next section"
    class="next-pin scroll-mt-[var(--frame-width)]"
    style={`--next-steps:${experiences.length}`}
  >
    <div class="next-stage">
      <div
        class="sunset-glow pointer-events-none absolute inset-x-0 bottom-0"
        aria-hidden="true"
      ></div>
      <div class="next-phrases pointer-events-none">
        <h2 class="next-title text-h2 font-bold">{title}</h2>
        <div class="next-phrase-list">
          {
            jobs.map(({ left, right, subtext, url, details }, i) => (
              <div
                class:list={[
                  "next-phrase text-h3",
                  !right && "next-phrase--center",
                ]}
                role="button"
                tabindex="0"
                aria-expanded="false"
                aria-controls={`next-details-${i}`}
              >
                <h2 class="next-phrase-main font-bold">
                  <span>{left}</span>
                  {right ? (
                    <span class="next-phrase-date text-h4">{right}</span>
                  ) : null}
                </h2>
                <div class="next-phrase-row">
                  {subtext ? (
                    <p class="next-phrase-sub text-h4">{subtext}</p>
                  ) : null}
                  <span class="next-phrase-more text-h5" aria-hidden="true">
                    <span class="next-phrase-more-label">
                      <span>Learn more</span>
                      <span>Show less</span>
                    </span>
                    <svg viewBox="0 0 24 14" width="14" height="8" fill="none">
                      <path
                        d="M3 3.5 L12 11.5 L21 3.5"
                        stroke="currentColor"
                        stroke-width="2.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </div>
                <div
                  id={`next-details-${i}`}
                  class="next-phrase-details"
                  inert
                >
                  <div>
                    <div class="next-phrase-details-body text-body">
                      {details.technologies ? (
                        <p class="next-phrase-tech">
                          Technologies Used: {details.technologies}
                        </p>
                      ) : null}
                      {details.description ? (
                        <p class="next-phrase-description">
                          {splitNumbers(details.description).map((part, j) =>
                            j % 2 ? <strong>{part}</strong> : part,
                          )}
                        </p>
                      ) : null}
                      {details.points?.length ? (
                        <ul class="next-phrase-points">
                          {details.points.map((point) => (
                            <li>
                              {splitNumbers(point).map((part, j) =>
                                j % 2 ? <strong>{part}</strong> : part,
                              )}
                            </li>
                          ))}
                        </ul>
                      ) : null}
                      {url ? (
                        <a
                          class="next-phrase-link text-h5"
                          href={url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Visit {left}
                          <span aria-hidden="true">↗</span>
                        </a>
                      ) : null}
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <div
        class="pointer-events-none absolute inset-x-0 -bottom-[var(--frame-width)]"
        aria-hidden="true"
      >
        <JaggedHills layer="back" />
      </div>
      <div
        class="pointer-events-none absolute bottom-[calc(12px-var(--frame-width))] left-1/2 w-full max-w-[36rem] -translate-x-1/2"
        aria-hidden="true"
      >
        <Volcano class="origin-bottom scale-y-108" />
      </div>
      <div
        class="pointer-events-none absolute inset-x-0 -bottom-[var(--frame-width)]"
        aria-hidden="true"
      >
        <JaggedHills layer="front" />
      </div>
    </div>
  </section>

  <section
    id="portfolio"
    aria-label="Projects"
    class="hills-ground flex flex-col items-center justify-center gap-12 px-8 py-24 md:px-16"
  >
    <h2
      class="w-full max-w-[min(1100px,92vw)] text-center text-h2 font-bold"
    >
      What I've Worked On
    </h2>
    <WorkGrid projects={PROJECTS_DATA.projects} />
    <div class="-mt-8 flex w-full max-w-[min(1100px,92vw)] justify-end">
      <a
        href="/portfolio"
        class="text-h3 inline-flex items-center gap-2 font-bold text-frame transition-colors hover:text-accent"
      >
        See Full Portfolio
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .next-pin {
    --next-step: 70vh;
    position: relative;
    z-index: 2;
    height: calc(
      100dvh - 2 * var(--frame-width) +
        (var(--next-steps) - 1) * var(--next-step)
    );
  }

  .next-stage {
    position: sticky;
    top: var(--frame-width);
    height: calc(100dvh - 2 * var(--frame-width));
  }

  /* Match the WorkGrid below: min(1100px, 92vw) inside the section's
     px-8 / md:px-16 padding. */
  .next-phrases {
    --phrase-gap: 6rem;
    --phrase-top: 34%;
    --phrase-width: min(1100px, 92vw, 100% - 4rem);
    position: absolute;
    inset: 0;
    z-index: 10;
  }

  @media (min-width: 48rem) {
    .next-phrases {
      --phrase-width: min(1100px, 92vw, 100% - 8rem);
    }
  }

  .next-phrase-list {
    position: absolute;
    inset: 0;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 30%);
    mask-image: linear-gradient(to bottom, transparent, #000 30%);
  }

  .next-title {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--phrase-top) - var(--phrase-gap) - 5rem);
    padding: 0 5rem;
    transform: translateY(-50%);
    text-align: center;
  }

  .next-phrase {
    position: absolute;
    left: 50%;
    top: var(--phrase-top);
    width: var(--phrase-width);
    opacity: var(--o, 0);
    transform: translate(-50%, -50%)
      translateY(calc(var(--d, 0) * var(--phrase-gap) + var(--shift, 0px)));
    will-change: transform, opacity;
  }

  .next-phrase-main {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2rem;
    width: 100%;
    line-height: 1.15;
  }

  .next-phrase-main > span {
    flex: 1 1 0;
  }

  .next-phrase-main > span:last-child {
    text-align: right;
  }

  /* Secondary to the company name: same weight and tone as the role line. */
  .next-phrase-date {
    font-weight: 400;
    color: color-mix(in srgb, var(--color-frame) 65%, transparent);
    font-variant-numeric: tabular-nums;
  }

  .next-phrase--center .next-phrase-main {
    justify-content: center;
  }

  .next-phrase--center .next-phrase-main > span {
    flex: 0 1 auto;
  }

  .next-phrase-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    margin-top: 0.5rem;
  }

  .next-phrase--center .next-phrase-row {
    flex-direction: column;
    gap: 0.5rem;
  }

  .next-phrase-more {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-left: auto;
    color: var(--color-frame);
    font-weight: 400;
    letter-spacing: 0.02em;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  /* Only the role in focus advertises "Learn more" (brighter on hover). */
  .next-phrase[data-current] .next-phrase-more {
    opacity: 0.5;
  }

  /* Both labels share one grid cell so the width doesn't jump on toggle. */
  .next-phrase-more-label {
    display: inline-grid;
    justify-items: end;
  }

  .next-phrase-more-label > span {
    grid-area: 1 / 1;
    transition: opacity 0.2s ease;
  }

  .next-phrase-more-label > span:last-child,
  .next-phrase.is-open .next-phrase-more-label > span:first-child {
    opacity: 0;
  }

  .next-phrase.is-open .next-phrase-more-label > span:last-child {
    opacity: 1;
  }

  .next-phrase-more svg {
    transition: transform 0.3s ease;
  }

  .next-phrase.is-open .next-phrase-more svg {
    transform: rotate(180deg);
  }

  .next-phrase-link {
    display: inline-flex;
    align-self: flex-start;
    gap: 0.35rem;
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(
      in srgb,
      var(--color-accent) 40%,
      transparent
    );
    text-underline-offset: 0.25em;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }

  .next-phrase-link:hover {
    color: var(--color-cream);
    text-decoration-color: currentColor;
  }

  .next-phrase--center .next-phrase-more {
    margin-left: 0;
  }

  .next-phrase[data-current]:hover .next-phrase-more,
  .next-phrase:focus-visible .next-phrase-more {
    opacity: 0.9;
  }

  .next-phrase.is-open .next-phrase-more {
    opacity: 0.9;
  }

  .next-phrase-sub {
    font-weight: 400;
    line-height: 1.15;
  }

  .next-phrase:nth-child(2) {
    --o: 1;
  }

  .next-phrase {
    cursor: pointer;
    pointer-events: auto;
    outline: none;
  }

  /* Faint card behind the role in focus, drawn outside the text box so the
     text stays aligned with the grid below. --open-h (set in JS) stretches
     it over the details while open. */
  .next-phrase::before {
    content: "";
    position: absolute;
    inset: -1.25rem -1.5rem calc(-1.25rem - var(--open-h, 0px));
    z-index: -1;
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.08);
    opacity: 0;
    transition:
      opacity 0.2s ease,
      bottom 0.4s ease;
    pointer-events: none;
  }

  .next-phrase[data-current]:hover::before,
  .next-phrase:focus-visible::before,
  .next-phrase.is-open::before {
    opacity: 1;
  }

  .next-phrase-more svg {
    translate: 0 0;
    transition:
      transform 0.3s ease,
      translate 0.2s ease;
  }

  .next-phrase[data-current]:hover:not(.is-open) .next-phrase-more svg {
    translate: 0 2px;
  }

  .next-phrase[data-hidden] {
    pointer-events: none;
  }

  .next-phrase:focus-visible .next-phrase-main {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Opacity is scroll-driven every frame; only ease it while toggling. */
  .next-pin.is-toggling .next-phrase {
    transition:
      opacity 0.35s ease,
      transform 0.4s ease;
  }

  /* While a role is open its neighbours stay in place, dimmed, so the list
     keeps its context; roles below are pushed down by --shift (set in JS). */
  .next-pin.has-open .next-phrase {
    opacity: calc(var(--o, 0) * 0.35);
  }

  .next-pin.has-open .next-phrase.is-open {
    opacity: 1;
  }

  .next-phrase-details {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    cursor: auto;
    transition:
      grid-template-rows 0.4s ease,
      opacity 0.3s ease;
  }

  .next-phrase-details > div {
    overflow: hidden;
  }

  .next-phrase-details-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.25rem;
    color: color-mix(in srgb, var(--color-frame) 80%, transparent);
  }

  .next-phrase-tech {
    font-style: italic;
  }

  .next-phrase-description strong,
  .next-phrase-points strong {
    font-weight: 700;
    color: var(--color-frame);
  }

  .next-phrase-points {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-left: 1.25em;
    list-style: disc;
  }

  .next-phrase-points li::marker {
    color: var(--color-accent);
  }

  .next-phrase.is-open .next-phrase-details {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .next-phrase-details,
    .next-pin.is-toggling .next-phrase {
      transition: none;
    }
  }

  /* Continues the front hills' base fill below the volcano: lit.fill to
     dark.fill across the centre over SPAN (220px at full size), scaled with
     the hills (see JaggedHills.astro). */
  .hills-ground {
    --ground-span: min(
      220px,
      (100vw - 2 * var(--frame-width)) * 220 / 576
    );
    min-height: 100vh;
    background: linear-gradient(
      to right,
      #4f4791 calc(50% - var(--ground-span)),
      #22275f calc(50% + var(--ground-span))
    );
  }

  .sunset-glow {
    height: 75vh;
    background: radial-gradient(
      ellipse 100% 100% at 50% 100%,
      rgba(242, 168, 94, 0.6) 0%,
      rgba(229, 115, 56, 0.4) 50%,
      rgba(229, 115, 56, 0) 100%
    );
  }

  .planet-scene {
    --planet-size: clamp(200px, 46vmin, 460px);
    position: relative;
    isolation: isolate;
    transform: translate(6%, 14%);
  }

  .planet-big {
    position: relative;
    z-index: 2;
  }

  .planet-mini {
    position: absolute;
    left: -19%;
    top: -29%;
    z-index: 1;
  }

  .scroll-hint {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    color: var(--color-frame);
    opacity: 0.25;
    transform: translateX(-50%);
    animation: scroll-hint 1.8s ease-in-out infinite;
    transition: opacity 0.2s ease;
  }

  .scroll-hint:hover {
    opacity: 0.6;
  }

  @keyframes scroll-hint {
    0%,
    100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, 7px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint {
      animation: none;
    }
  }
</style>

<script>
  const pin = document.querySelector<HTMLElement>(".next-pin");
  const stage = pin?.querySelector<HTMLElement>(".next-stage");
  const phrases = Array.from(
    pin?.querySelectorAll<HTMLElement>(".next-phrase") ?? [],
  );

  if (pin && stage && phrases.length > 1) {
    const count = phrases.length;
    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let pinTop = 0;
    let total = 0;
    let step = 0;
    let start = 0;
    let end = 0;
    let queued = false;
    let settleTimer = 0;
    let dir = 1;
    let lastY = 0;

    const measure = () => {
      const stickyTop = parseFloat(getComputedStyle(stage).top) || 0;
      pinTop = pin.getBoundingClientRect().top + window.scrollY;
      total = pin.offsetHeight - stage.offsetHeight;
      step = total / (count - 1);
      start = pinTop - stickyTop;
      end = start + total;
      lastY = window.scrollY;
    };

    const render = () => {
      queued = false;

      const progress =
        total > 0
          ? Math.min(1, Math.max(0, (window.scrollY - start) / total))
          : 1;
      const pos = progress * (count - 1);

      phrases.forEach((phrase, i) => {
        const d = i - pos;
        const falloff = d >= 0 ? 1 - d / 3 : 1 - Math.abs(d) / 2;
        const opacity = Math.max(0, falloff) ** 2.5;
        phrase.style.setProperty("--d", d.toFixed(4));
        phrase.style.setProperty("--o", opacity.toFixed(4));
        phrase.toggleAttribute("data-hidden", opacity < 0.05);
        phrase.toggleAttribute("data-current", Math.abs(d) < 0.5);
      });
    };

    // Click the role in focus to reveal its details; click a faded role to
    // scroll it into focus. Click anywhere else (or the role again, Escape,
    // or scroll away) to collapse.
    let openIndex = -1;
    let openTarget = 0;
    let toggleTimer = 0;

    const flashToggling = () => {
      pin.classList.add("is-toggling");
      window.clearTimeout(toggleTimer);
      toggleTimer = window.setTimeout(
        () => pin.classList.remove("is-toggling"),
        400,
      );
    };

    // Push the roles below the open one down by its details' height so the
    // details expand in place instead of overlapping the next role.
    const shiftBelow = (i: number) => {
      const body = phrases[i]?.querySelector<HTMLElement>(
        ".next-phrase-details > div",
      );
      const h = i >= 0 && body ? body.scrollHeight : 0;
      phrases.forEach((phrase, j) => {
        if (j > i && h) phrase.style.setProperty("--shift", `${h}px`);
        else phrase.style.removeProperty("--shift");
        if (j === i && h) phrase.style.setProperty("--open-h", `${h}px`);
        else phrase.style.removeProperty("--open-h");
      });
    };

    const close = () => {
      if (openIndex < 0) return;
      shiftBelow(-1);
      const phrase = phrases[openIndex];
      phrase.classList.remove("is-open");
      phrase.querySelector(".next-phrase-details")?.setAttribute("inert", "");
      phrase.setAttribute("aria-expanded", "false");
      pin.classList.remove("has-open");
      openIndex = -1;
      flashToggling();
    };

    const reveal = (i: number) => {
      openIndex = i;
      phrases[i].classList.add("is-open");
      phrases[i]
        .querySelector(".next-phrase-details")
        ?.removeAttribute("inert");
      phrases[i].setAttribute("aria-expanded", "true");
      shiftBelow(i);
      pin.classList.add("has-open");
      flashToggling();
    };

    // A role that isn't in focus only scrolls into focus; a second click
    // opens it.
    const open = (i: number) => {
      close();
      window.clearTimeout(settleTimer);
      const target = start + i * step;

      if (Math.abs(window.scrollY - target) < 2) {
        openTarget = target;
        reveal(i);
        return;
      }

      window.scrollTo({ top: target, behavior: reduce ? "auto" : "smooth" });
    };

    phrases.forEach((phrase, i) => {
      phrase.addEventListener("click", (e) => {
        if ((e.target as Element).closest(".next-phrase-details")) return;
        e.stopPropagation();
        if (openIndex === i) close();
        else open(i);
      });
      phrase.addEventListener("keydown", (e) => {
        if (e.target !== phrase) return;
        if (e.key !== "Enter" && e.key !== " ") return;
        e.preventDefault();
        if (openIndex === i) close();
        else open(i);
      });
    });

    document.addEventListener("click", (e) => {
      if (openIndex < 0) return;
      if (phrases[openIndex].contains(e.target as Node)) return;
      close();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      close();
    });

    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(render);
    };

    const settle = () => {
      const y = window.scrollY;
      if (y <= start + 1 || y >= end - 1) return;

      const raw = (y - start) / step;
      const index = dir > 0 ? Math.ceil(raw - 0.001) : Math.floor(raw + 0.001);
      const clamped = Math.min(count - 1, Math.max(0, index));
      const target = start + clamped * step;

      if (Math.abs(target - y) < 2) return;
      window.scrollTo({ top: target, behavior: reduce ? "auto" : "smooth" });
    };

    const onScroll = () => {
      schedule();

      const y = window.scrollY;
      if (y > lastY) dir = 1;
      else if (y < lastY) dir = -1;
      lastY = y;

      if (openIndex >= 0) {
        if (Math.abs(y - openTarget) > 40) close();
        else return;
      }

      window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(settle, 140);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => {
      measure();
      if (openIndex >= 0) shiftBelow(openIndex);
      schedule();
    });
    window.addEventListener("load", () => {
      measure();
      schedule();
    });

    measure();
    render();
  }
</script>
