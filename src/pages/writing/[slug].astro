---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BarPlanet from "@/components/BarPlanet.astro";
import { getCollection, render } from "astro:content";
import { SITE } from "@/consts";

export async function getStaticPaths() {
  const posts = await getCollection("writing");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout title={`${post.data.title} | ${SITE.title}`}>
  <article
    class="mx-auto flex w-full max-w-[min(760px,100%)] flex-col gap-10 px-6 pt-32 pb-24 sm:px-8"
  >
    <a
      href="/writing"
      class="self-start text-h5 text-cream transition-colors hover:text-accent"
      >&larr; All writing</a
    >
    <header class="post-header">
      <div class="flex flex-col gap-3">
        <time
          datetime={post.data.date.toISOString()}
          class="post-date text-h5"
        >
          {date}
        </time>
        <h1 class="text-h1 font-bold">{post.data.title}</h1>
      </div>
      <div class="post-planet" aria-hidden="true">
        <BarPlanet variant="green" size="clamp(70px, 14vw, 110px)" glow={0.3} />
      </div>
    </header>
    <div class="post-body text-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 2rem;
    border-bottom: 2px dashed rgb(255 255 255 / 0.12);
  }

  .post-planet {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: clamp(90px, 18vw, 140px);
    aspect-ratio: 1;
  }

  .post-date {
    color: var(--color-flare);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .post-body {
    color: rgb(255 255 255 / 0.88);
  }

  .post-body :global(strong) {
    color: var(--color-accent);
    font-weight: 600;
  }

  /* Markdown headings match the site's h1/h2/h3 treatment. */
  .post-body :global(h1) {
    font-size: var(--text-h1);
    line-height: var(--text-h1--line-height);
    letter-spacing: var(--text-h1--letter-spacing);
    font-weight: 800;
  }

  .post-body :global(h2) {
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    font-weight: 700;
  }

  .post-body :global(h3) {
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    font-weight: 700;
  }

  .post-body :global(:is(h1, h2, h3)) {
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .post-body :global(:is(h1, h2, h3):first-child) {
    margin-top: 0;
  }

  .post-body :global(p + p) {
    margin-top: 1.25em;
  }

  .post-body :global(a) {
    color: var(--color-cream);
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .post-body :global(a:hover) {
    color: var(--color-accent);
  }

  .post-body :global(code) {
    font-size: 0.9em;
    color: var(--color-accent);
  }
</style>
