---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { SITE } from "@/consts";

const posts = (await getCollection("writing")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
---

<BaseLayout title={`Writing | ${SITE.title}`}>
  <section
    aria-label="Writing"
    class="flex flex-col items-center gap-12 px-8 pt-32 pb-24 md:px-16"
  >
    <h1
      class="w-full max-w-[min(1100px,92vw)] text-center text-h1 font-extrabold"
    >
      Writing
    </h1>
    {
      posts.length ? (
        <ul class="flex w-full max-w-[min(760px,92vw)] flex-col gap-6">
          {posts.map((post) => (
            <li>
              <a
                href={`/writing/${post.id}`}
                class="flex flex-col gap-1 transition-colors hover:text-accent sm:flex-row sm:items-baseline sm:justify-between sm:gap-8"
              >
                <span class="text-h3 font-bold">{post.data.title}</span>
                <time
                  datetime={post.data.date.toISOString()}
                  class="shrink-0 text-h5 text-cream"
                >
                  {formatDate(post.data.date)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-center text-h4">Nothing here yet...?</p>
      )
    }
  </section>
</BaseLayout>
