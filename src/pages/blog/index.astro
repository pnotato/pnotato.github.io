---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title="Blog — Nicholas Chan" description="Writing by Nicholas Chan.">
  <section class="blog-index">
    <h1>Blog</h1>
    {
      posts.length === 0 ? (
        <p class="blog-empty">No posts yet. Check back soon.</p>
      ) : (
        <ul class="blog-list">
          {posts.map((post) => (
            <li class="blog-list-item">
              <a href={`/blog/${post.id}/`} class="blog-list-link">
                <time class="blog-list-date" datetime={post.data.pubDate.toISOString()}>
                  {dateFormatter.format(post.data.pubDate)}
                </time>
                <h2 class="blog-list-title">{post.data.title}</h2>
                {post.data.description && (
                  <p class="blog-list-description">{post.data.description}</p>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
